{
    "manifest_version": 3,
    "default_locale": "en",

    "name": "WebShortcuts",
    "description": "Run custom automated agents and on-demand shortcut actions on web pages.",
    "version": "1.0",

    "icons": {
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png",
        "256": "images/icon-256.png",
        "512": "images/icon-512.png"
    },

    "background": {
        "scripts": [ "background.js" ],
        "type": "module"
    },

    "action": {
        "default_popup": "popup.html",
        "default_icon": "images/toolbar-icon.svg"
    },

    "permissions": [
        "scripting",
        "storage",
        "activeTab",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ]
}
